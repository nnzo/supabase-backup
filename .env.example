# Required: Postgres connection string for your Supabase database.
# Find it in the Supabase Dashboard → Project Settings → Database → Connection string.
# Prefer the "Direct connection" (port 5432). If your host has no IPv6 connectivity,
# use the "Session pooler" string instead (also port 5432, user postgres.<ref>).
# Avoid the transaction pooler (port 6543) — it is unreliable for pg_dump.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Directory where timestamped backup folders are stored.
# Relative paths are resolved against this script's directory. Default: ./backups
# BACKUP_DIR=./backups

# How many backups to keep before the oldest are deleted. Default: 7
# BACKUP_KEEP=7

# Set to false to skip backups without removing the cron job. Default: true
# BACKUP_ENABLED=true

# Comma-separated list of schemas to include in the schema/data dumps.
# Default: all schemas (a true full-database backup). If dumping hosted Supabase
# fails with permission errors on managed schemas, try: public
# BACKUP_SCHEMAS=public
